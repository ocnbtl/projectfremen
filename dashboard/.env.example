ADMIN_PASSWORD=change-me
# Keep this stable: it signs admin sessions and derives the encrypted password-store key.
ADMIN_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Leave legacy mode on the existing Vercel deployment. Use workspace on the isolated account host.
UNIGENTAMOS_AUTH_MODE=legacy
# Required in workspace mode. Use the browser-facing HTTPS origin, or http://127.0.0.1:PORT for local QA.
UNIGENTAMOS_ACCOUNT_ORIGIN=
# The workspace server uses this key for Supabase Auth and the service role for private database operations.
SUPABASE_PUBLISHABLE_KEY=
FREMEN_REQUIRE_SUPABASE=false
GITHUB_TOKEN=
DOCS_REPOS=ocnbtl/projectfremen:main,pngwn-zero/pngwn-web:main,ocnbtl/projectpint:main
DOCS_MAX_FILES=120
FREMEN_DATA_DIR=
FREMEN_REQUIRE_PERSISTENT_DATA=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_ORG_SLUG_PNGWN=
SENTRY_ORG_SLUG_DIYESU=
SENTRY_PROJECT_SLUG_PNGWN=
SENTRY_PROJECT_SLUG_DIYESU=
SENTRY_API_BASE_URL=https://sentry.io/api/0
SENTRY_KPI_QUERY=is:unresolved
SENTRY_KPI_NAME_PNGWN=Errors Reported in Sentry
SENTRY_KPI_NAME_DIYESU=Errors Reported in Sentry
OBSIDIAN_EXPORT_DIR=
# Booking confirmations (server-only): use a verified sender domain.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_NOTIFY_EMAIL=
# Authenticates the daily recovery sweep for queued booking emails.
CRON_SECRET=

# Shared account media. Keep the legacy source readable on both hosts.
FREMEN_ACCOUNT_MEDIA_BACKEND=supabase
# New individual-workspace uploads require an explicitly configured private Standard bucket.
WORKSPACE_MEDIA_BACKEND=
R2_ACCOUNT_ID=
R2_MEDIA_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bytes initially included when a workspace first reserves an upload.
WORKSPACE_INCLUDED_STORAGE_BYTES=0
# Optional owner-visible proposal. No checkout or billing integration is enabled.
# Set currency, flatMonthlyMinor, addonMonthlyMinor and addonBytes as one JSON object.
WORKSPACE_STORAGE_OFFER_JSON=

# Optional account notification delivery (staging values belong to staging only).
WORKSPACE_NOTIFICATION_FROM=
WORKSPACE_PUSH_PUBLIC_KEY=
WORKSPACE_PUSH_PRIVATE_KEY=
WORKSPACE_PUSH_CONTACT=
WORKSPACE_NOTIFICATION_WORKER_TOKEN=
